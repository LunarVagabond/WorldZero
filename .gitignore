# -----------------------------------------------------------------------------
# WorldZero — generated artifacts, dependencies, secrets, and local tooling
# -----------------------------------------------------------------------------

# Rust
target/
**/*.rs.bk
# Cargo.lock is intentionally NOT ignored — WorldZero ships runnable services/binaries,
# so the lockfile is committed for reproducible builds, per Rust convention for apps.

# Environment and secrets
.env
.env.*
!.env.example
*.local
*.key

# gateway's self-signed TLS/DTLS cert, generated on first run
# (docs/specs/Networking_Spec.md, "TLS (TCP channel)") — not authored,
# doesn't belong in git the way a dev's own config/*.yaml does
config/certs/

# The local content-addressed asset store (#279,
# docs/specs/Content_Manifest_Spec.md, "Content-addressing") — real
# binary asset files a self-hoster drops in by hand, not source.
# Exception: the shipped example zones' own navmesh_v1 assets (#280) ARE
# committed below, the same way config/example-zones/*.yaml is — without
# them the shipped content-pack.example.yaml/zone.manifest.example.yaml
# wouldn't actually run out of the box on a fresh clone.
config/assets/*
!config/assets/9053d0456606fc25a498de1e85a29615605e870bbda12e4f087420ca9a00c168
!config/assets/48b4d7e0c79652088cb1bb4a73a25baea58d1738681df133be226a5dfa2b92bd

# A dev's own real config, copied/customized from the tracked
# config/*.example.* templates (by hand, or by `make quickstart`, #43) —
# never the templates themselves.
config/game.yaml
config/zone.manifest.yaml
config/stats.schema.yaml
config/party.schema.yaml
config/currency.schema.yaml
config/plugin.toml

# Logs
logs/
*.log

# make start/stop (Makefile) — per-service pid/log files
_running/

# Test and coverage output
coverage/
*.lcov

# Caches and incremental build metadata
.cache/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor and IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.iml
.fleet/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# Vim / Emacs swap files
*.swp
*.swo
*~
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
Session.vim
.netrwhist

# Windows / Visual Studio
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Debug and profiling
*.prof
*.profraw
criterion/

# Patch and merge leftovers
*.orig
*.rej

# Optional local scratch
tmp/
temp/
scratch/

# Built plugin wasm artifacts (build from examples/<plugin>, don't commit the binary)
config/plugins/*/*.wasm
