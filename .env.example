# Point these at whatever Postgres/Redis you're using — a remote/VM
# instance, a container you started yourself, or `make docker-up`'s
# docker-compose Postgres/Redis (small teams/sandboxing only — see
# docs/product/Getting_Started_Developers.md). If you're using
# `make docker-up`, set WZ_POSTGRES_HOST/WZ_REDIS_HOST to `localhost`
# once the containers are up.
WZ_POSTGRES_HOST=
WZ_POSTGRES_PORT=5432
WZ_POSTGRES_USER=
WZ_POSTGRES_PASSWORD=
WZ_POSTGRES_DATABASE=

WZ_REDIS_HOST=
WZ_REDIS_PORT=6379
WZ_REDIS_PASSWORD=
