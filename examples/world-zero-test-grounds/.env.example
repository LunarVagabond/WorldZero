# World Zero Test Grounds — client-side dev config (PROMPT.md §9.3).
# Copy this to `.env` (gitignored). This is NOT the backend's own .env
# (that one lives in ../world_zero and configures Postgres/Redis — see
# this project's README).

# Where the World Zero `server` process (run separately) is listening.
WZ_TEST_SERVER_HOST=127.0.0.1
WZ_TEST_SERVER_PORT=7900

# Not used by this client (it disables TLS certificate validation for
# local dev instead — see README's "TLS" section) — left here only so
# the shape matches PROMPT.md §9.3 exactly, in case you switch strategies.
WZ_TEST_TLS_CERT_PATH=

# A default account to auto-fill the login form with during manual
# testing — purely a convenience, leave blank to always type credentials
# by hand.
WZ_TEST_DEFAULT_USERNAME=
WZ_TEST_DEFAULT_PASSWORD=
