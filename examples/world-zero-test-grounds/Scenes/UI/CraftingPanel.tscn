[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://Scenes/UI/CraftingPanel.cs" id="1"]

[node name="CraftingPanel" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Scroll" type="ScrollContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
horizontal_scroll_mode = 0

[node name="Box" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Hint" type="Label" parent="Scroll/Box"]
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 3
text = "recipe_key (must be declared in crafting.schema.yaml on the backend):"

[node name="Row" type="HBoxContainer" parent="Scroll/Box"]
layout_mode = 2

[node name="RecipeEdit" type="LineEdit" parent="Scroll/Box/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="CraftButton" type="Button" parent="Scroll/Box/Row"]
unique_name_in_owner = true
layout_mode = 2
text = "Craft"

[node name="ReplyHint" type="Label" parent="Scroll/Box"]
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 3
text = "No success/failure reply beyond ItemChanged pushes (or Error) — watch the Debug tab's event log."
