[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://Scenes/UI/AdminPanel.cs" id="1"]

[node name="AdminPanel" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Scroll" type="ScrollContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
horizontal_scroll_mode = 0

[node name="Box" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Hint" type="Label" parent="Scroll/Box"]
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 3
text = "Every command here is re-checked server-side against your account's real \"admin\" or \"qa\" role — this panel only ever shows for an account that already announced it has one of them."

[node name="GrantSection" type="PanelContainer" parent="Scroll/Box"]
layout_mode = 2

[node name="GrantBox" type="VBoxContainer" parent="Scroll/Box/GrantSection"]
layout_mode = 2

[node name="Header" type="Label" parent="Scroll/Box/GrantSection/GrantBox"]
layout_mode = 2
modulate = Color(0.75, 0.85, 1, 1)
