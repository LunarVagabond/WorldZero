// v0 plugin interface — docs/PROPOSAL.md ("Plugin System", "v0 Hooks",
// "v0 Host Functions") and docs/specs/Plugin_API.md ("v0 world").
//
// #38 built the minimal slice (one NPC spawn, one interaction). #116
// (split from #57) added combat, NPC route/patrol, and chat-command
// hooks. #57 added inventory/economy. #124 adds `caller-role`, the
// account-roles decision (#114) needed to gate dev/admin-only
// plugin-declared chat commands. #155 adds `on-player-join-zone`/
// `on-player-leave-zone` (docs/PROPOSAL.md's "Player session" hook
// group). #154 adds real client-protocol call sites for
// `on-damage-calc`/`on-item-use`/`on-npc-interact` (`server`'s new
// `Attack`/`UseItem`/`InteractNpc` client actions) and `report-death`/
// `report-respawn` host functions — the plugin-owned trigger for
// `on-death`/`on-respawn` (core still has no notion of what "died"
// means; a plugin reports it once it decides, and the host fires the
// hook back). #153 adds real capability gating
// (`plugin_host::manifest::KNOWN_CAPABILITIES`). #152 moves to **one
// plugin instance per process** rather than one per zone-service — every
// event hook that fires for something zone-specific now takes an
// explicit `zone-id` parameter, and `on-zone-loaded(zone-id)` replaces
// the old "on-load fires once per zone" implicit scoping — see the
// `hooks` interface's own doc comment below for the full reasoning. #194
// adds `on-character-create` and `apply-stat-delta-for-character` — the
// character-creation extension point (starting stats, archetype/preset
// systems built as a plugin rather than a core class/race enum), the one
// hook that fires before any entity exists for the thing it's about,
// hence the one narrow exception to "every id crossing this boundary is
// an entity id." #214 adds a `spawn-table-id` parameter to
// `on-entity-spawn` and wires it up for real (it previously existed in
// this file but nothing ever called it) — the correlation token a plugin
// needs to match a specific `spawn-npc` call to the `on-entity-spawn`
// event it eventually causes, since `spawn-npc` itself can't
// synchronously return the real entity id (see both hooks' doc comments
// below). #216 adds `on-craft-complete` — the post-craft notification
// for #215's generic crafting decision, gated behind the `economy`
// capability at the firing site (`server::session`) rather than through
// a host-function call, since it has no corresponding host function to
// gate. See
// docs/specs/Plugin_API.md, "Beyond this v0 slice" for what still isn't
// here. #218 adds a `currency-key` parameter to `modify-currency` — a
// dev-declared multi-currency system (`currency.schema.yaml`,
// #217's decision) replaces the old implicit single balance, so a
// currency's identity now has to cross this boundary too. #168 adds
// `on-tick` — a zone-wide hook fired once per zone per tick regardless
// of NPC count, distinct from `on-npc-tick` below (which fires once per
// route-NPC): for time-of-day, periodic world events, or aggregate
// bookkeeping a plugin wants to run on a fixed cadence rather than
// per-entity. #186 adds `block-zone-channel` — the block/restriction
// primitive a dev calls to prevent an entity from auto-joining (or
// joining at all) a zone-scoped chat channel category, the counterpart to
// `server`'s new zone-entry auto-join behavior for `chat.yaml` categories
// declared `auto_join: true`. A WIT "world"
// is the actual versioning mechanism (docs/PROPOSAL.md, "Interface
// Technology"): a breaking change bumps the package version below
// and/or lands as a new world, rather than silently changing what
// `plugin` means underneath existing compiled plugins.

package worldzero:plugin@0.13.0;

/// What the host exposes for a plugin to call out to — nothing crosses
/// this boundary that isn't listed here (docs/PROPOSAL.md, "Plugin
/// System": "no direct DB access, no raw network access, no filesystem
/// access, ever").
interface host {
    /// Requests one NPC spawn from a zone's declared spawn table
    /// (content::manifest::SpawnTable). The `Ok` string is **not** the
    /// real entity id — the host can't synchronously assign one from
    /// inside this sandboxed call (the real entity is only created later,
    /// once the caller drains the request outside the WASM call, the same
    /// "can't touch `&mut Zone`/the DB from inside a sandboxed sync call"
    /// constraint every other queued host function in this interface has)
    /// — it is `spawn-table-id` echoed back, only useful as a same-call
    /// sanity check, never a real entity id. To actually learn the real
    /// entity id — and correlate it back to this specific call, if the
    /// plugin made more than one for the same table — consume
    /// `on-entity-spawn` below — it fires back to this plugin, carrying
    /// `spawn-table-id`, once the spawn actually lands (#214).
    spawn-npc: func(spawn-table-id: string) -> result<string, string>;

    /// Sends a visible message to one connected client, addressed by
    /// entity id — the v0 "make the interaction have a visible effect"
    /// primitive (#38's acceptance criteria).
    send-message: func(target-entity-id: string, body: string) -> result<_, string>;

    /// Adjusts one declared stat (docs/specs/Data_Model_Spec.md's
    /// `stats.schema.yaml`) by `delta` — the "reduce a plugin-specified
    /// stat by N" primitive docs/PROPOSAL.md's "v0 Host Functions"
    /// names. Core has no notion of HP or damage; `stat-key` is whatever
    /// key the game's own declared schema defines, validated the same
    /// way `character::CharacterStore::set_stat` validates any other
    /// write (unknown key or out-of-`[min,max]` result is rejected, the
    /// write never reaches storage). This is how a plugin actually
    /// carries out what `on-damage-calc`/`on-death`/`on-respawn` decide.
    apply-stat-delta: func(entity-id: string, stat-key: string, delta: s64) -> result<_, string>;

    /// Same validated-write discipline as `apply-stat-delta`, but
    /// identifies the target by `character-id` directly instead of an
    /// entity id (#194) — the counterpart for `on-character-create`,
    /// which fires before any entity/session exists for the character
    /// being created, so there is no entity id yet to pass. Every other
    /// function in this interface deliberately treats an id as opaque
    /// and never as a character id directly (docs comment above); this
    /// is the one narrow, documented exception, scoped to the one hook
    /// that has no entity id available. Rejected if `character-id`
    /// doesn't name a real character.
    apply-stat-delta-for-character: func(character-id: string, stat-key: string, delta: s64) -> result<_, string>;

    /// Queues a move for `entity-id` to `(x, y, z)`, applied and
    /// validated on the zone's next tick through the exact same
    /// authoritative path a player's own movement goes through
    /// (`world::Zone::request_move` / `world::movement::validate_movement`,
    /// 3D-aware since #249) — a plugin never moves an entity by writing
    /// its position directly. This is the primitive `on-npc-tick` is
    /// expected to drive: the host hands the plugin its NPC's route data
    /// every tick, the plugin decides where it should be next and calls
    /// this to make it happen.
    move-entity: func(entity-id: string, x: f64, y: f64, z: f64) -> result<_, string>;

    /// Grants `quantity` of `item-type` to `entity-id` — queued and
    /// applied through `character::CharacterStore::grant_item` on the
    /// zone's next drain, same "validated write, never a direct storage
    /// write" discipline as `apply-stat-delta`
    /// (docs/specs/Data_Model_Spec.md's `items` table, #112). `item-type`
    /// is an opaque string the host never interprets — what an item type
    /// *means* is entirely plugin-owned. Only resolves for player
    /// entities today: `entity-id` must belong to a connected player, an
    /// NPC entity id is rejected (no NPC item ownership storage exists —
    /// items are character-owned only). A successful grant fires
    /// `on-item-acquire` back to this plugin once applied.
    grant-item: func(entity-id: string, item-type: string, quantity: s64) -> result<_, string>;

    /// Removes `quantity` of `item-type` from `entity-id` — queued and
    /// applied through `character::CharacterStore::remove_item`. Same
    /// player-entity-only caveat as `grant-item`. Rejected (nothing
    /// applied) if the character doesn't own at least `quantity` — this
    /// happens asynchronously during the drain, so (like `apply-stat-delta`)
    /// a plugin gets an immediate `ok` for having queued the request, not
    /// confirmation the removal actually succeeded; check via a
    /// subsequent hook/message if that matters to the plugin's logic.
    remove-item: func(entity-id: string, item-type: string, quantity: s64) -> result<_, string>;

    /// Adjusts `entity-id`'s balance of `currency-key` (one of the
    /// dev-declared currencies in `currency.schema.yaml`, #217/
    /// #218 — an opaque string the host never interprets beyond looking
    /// it up) by `delta` (positive or negative) — queued and applied
    /// through `character::CharacterStore::modify_currency`. Same
    /// player-entity-only caveat and same "queued, not confirmed
    /// synchronously" caveat as `remove-item`. Rejected (nothing applied)
    /// if `currency-key` isn't a declared currency, or if the result
    /// would go negative — each currency's balance is independent, so
    /// going negative on one never affects another.
    modify-currency: func(entity-id: string, currency-key: string, delta: s64) -> result<_, string>;

    /// Returns the roles (docs/specs/Auth_Spec.md, "Account roles",
    /// decision #114) held by the account behind `entity-id` — global
    /// scope for v0, no per-realm distinction (deferred until
    /// `realm-directory`/#47 exists and per-realm admin becomes a real
    /// requirement). Empty list if the account holds no roles, which is
    /// the common case — not an error. A plugin's `on-chat-command`
    /// handler queries this itself to gate dev/admin-only commands;
    /// `plugin.toml` does not declare a required role per command for v0.
    /// Unlike every other function here, this is answered from an
    /// in-memory cache populated at session join, not a live DB read —
    /// the same "no synchronous DB query from inside the sandboxed call"
    /// constraint noted in docs/specs/Plugin_API.md's "Beyond this v0
    /// slice" for why a general query host function doesn't exist; only
    /// resolves for a connected player entity (an NPC entity id, or one
    /// no longer connected, is rejected).
    caller-role: func(entity-id: string) -> result<list<string>, string>;

    /// Which "bucket" a plugin-state key lives in, and which id it's
    /// scoped to (docs/PROPOSAL.md's "Plugin-Scoped Data Store", #149).
    /// `character`/`zone` are durable (Postgres); `entity` is transient
    /// — in-memory only, does not survive a restart. The core never
    /// looks inside a stored value; it's an opaque blob to the host,
    /// meaning entirely plugin-owned.
    variant plugin-state-scope {
        character(string),
        entity(string),
        zone(string),
    }

    /// Reads a previously-stored blob for `scope`/`key` — `none` if
    /// nothing has been stored yet, not an error. Answered from an
    /// in-memory cache (hydrated at the right lifecycle point per scope
    /// — character state at session join, zone state at zone-actor
    /// startup), never a live DB read from inside this sandboxed call —
    /// same "no synchronous DB query from inside a host call" constraint
    /// `caller-role` documents above.
    plugin-state-get: func(scope: plugin-state-scope, key: string) -> result<option<list<u8>>, string>;

    /// Stores a blob for `scope`/`key`, overwriting whatever was there.
    /// Applied to the in-memory cache immediately (a `plugin-state-get`
    /// right after this call sees it in the same session), and for the
    /// two durable scopes, queued for the next tick's drain — same
    /// "queued, not synchronously confirmed" shape as
    /// `apply-stat-delta`/`grant-item`. `entity` scope has nothing to
    /// queue — it was never going to be persisted.
    plugin-state-set: func(scope: plugin-state-scope, key: string, value: list<u8>) -> result<_, string>;

    /// Reports that `entity-id` has died — the plugin decides what "died"
    /// means for its own game (e.g. a declared stat it just drove to
    /// zero via `apply-stat-delta`) and calls this itself; the host has
    /// no privileged notion of death (docs/PROPOSAL.md's "Combat" hook
    /// group: "core has no notion of HP or a death condition"). Queued,
    /// applied on the zone's next tick drain — fires `on-death` back to
    /// every loaded plugin once applied (today: just the caller's own,
    /// forward-compatible with #152's planned multi-plugin fan-out) —
    /// same "queued, not synchronously confirmed" shape as
    /// `apply-stat-delta` (#154).
    report-death: func(entity-id: string) -> result<_, string>;

    /// Same shape as `report-death`, for the respawn case — fires
    /// `on-respawn` once applied (#154).
    report-respawn: func(entity-id: string) -> result<_, string>;

    /// Prevents `entity-id` from auto-joining the zone-scoped chat
    /// channel declared under `category` (`chat.yaml`'s
    /// `system_channels[].category`, docs/specs/Chat_Spec.md) — the
    /// block/restriction primitive #186 asks for, e.g. gating a city
    /// channel behind a quest flag or account role
    /// (`caller-role` above answers the latter). Applied immediately to
    /// an in-memory, per-entity, per-connection set — same durability
    /// class as `caller-role`'s own cache (cleared on disconnect, never
    /// persisted), not a durable ban list; a game wanting a block that
    /// survives reconnects re-declares it each time (e.g. from
    /// `on-player-join-zone`). Only affects auto-join going forward: it
    /// does not retroactively leave a channel this entity already
    /// auto-joined before the call — a plugin blocking a category ahead
    /// of a zone entry (e.g. from the *previous* zone's
    /// `on-player-leave-zone`) is what actually prevents the join.
    /// Rejected if `entity-id` isn't a validly-formed entity id — unlike
    /// `caller-role`, this doesn't require the entity to currently be
    /// connected (a plugin may reasonably call this from a hook that
    /// fires mid-disconnect, e.g. `on-player-leave-zone`).
    block-zone-channel: func(entity-id: string, category: string) -> result<_, string>;
}

/// What the host calls into the plugin for — a plugin only receives the
/// hooks it actually cares about; v0 doesn't yet have per-hook opt-out
/// at the WIT level (docs/PROPOSAL.md's "Plugin Manifest & Capability
/// Declaration" full story is deferred past this minimal slice) — a
/// plugin's `hooks` declaration in `plugin.toml` is what actually gates
/// whether the host calls it (#152), not this interface itself.
///
/// **One plugin instance, process-wide (#152).** A plugin is loaded
/// exactly once per `server` process, not once per zone — `server` runs
/// one zone-service task per zone, and every one of them dispatches into
/// this same shared instance. `zone-id` is therefore an explicit
/// parameter on every hook below that fires for a specific event, not
/// something a plugin can infer from "which instance is this" (there's
/// only one). A plugin that only cares about specific zones checks
/// `zone-id` itself inside its own hook bodies — the host never filters
/// events by zone on a plugin's behalf.
interface hooks {
    /// Called once, at process startup, when the plugin is first loaded
    /// — before any zone-service exists yet. For genuinely global setup
    /// only (initializing the plugin's own bookkeeping); anything that
    /// needs to act on a specific zone (e.g. spawning that zone's NPCs)
    /// belongs in `on-zone-loaded` below, not here.
    on-load: func();

    /// Called once before the plugin is torn down (process shutdown).
    on-unload: func();

    /// Called once per zone-service, as that zone starts up — the
    /// per-zone counterpart to `on-load` (#152). This is where a plugin
    /// does zone-specific initialization (e.g. `spawn-npc` calls for
    /// that zone's own spawn tables) using `zone-id` to decide what, if
    /// anything, to do for this particular zone.
    on-zone-loaded: func(zone-id: string);

    /// Fired once, right after a new character row is created
    /// (`server::character_protocol`'s `CreateCharacter`, #193) and
    /// before the client's `CharacterCreated` acknowledgement is sent —
    /// no entity/session exists yet for this character (it hasn't
    /// spawned into any zone), which is why this hook carries
    /// `character-id` rather than an entity id, and why setting starting
    /// stats here means calling `apply-stat-delta-for-character`, not
    /// `apply-stat-delta`. `zone-id` is the character's starting zone
    /// (the deployment's default) — given up front since there's no
    /// zone-service dispatch context to infer it from; this hook does
    /// not fire from any particular zone-service's event loop. The
    /// intended extension point for a plugin-driven archetype/preset/
    /// starting-stat system (docs/PROPOSAL.md: "no game-specific
    /// concept, not even HP, is privileged by the core" — class/race
    /// selection is deliberately plugin territory, not a core concept,
    /// #194). Listing presets *before* a client commits to
    /// `CreateCharacter` (so a UI can show choices up front) is
    /// explicitly out of scope here — a fire-after-creation hook can't
    /// do that; a real "ask a plugin for a list of options" request/
    /// response mechanism is deferred to a follow-up ticket.
    on-character-create: func(character-id: string, zone-id: string);

    /// Fired once an NPC requested via `spawn-npc` is actually spawned
    /// (`server::world_actor::spawn_npc_from_table` calls this itself
    /// right after creating the real entity, same "confirmation, not a
    /// request" shape as `on-item-acquire`/`on-death` — see those hooks'
    /// own doc comments) — `entity-type` matches
    /// content::manifest::SpawnTable's `entity_type` field (e.g.
    /// "npc.wolf"). `spawn-table-id` is the id passed to the `spawn-npc`
    /// call that caused this spawn (#214) — the correlation token a
    /// plugin needs to match a specific `on-entity-spawn` event back to a
    /// specific `spawn-npc` call, since `spawn-npc` itself can't
    /// synchronously return the real entity id (the real entity is only
    /// created later, once the caller drains the request outside the
    /// sandboxed call — see `spawn-npc`'s own doc comment below). Because
    /// requests for the same `spawn-table-id` are drained, spawned, and
    /// fired back to this same plugin in the exact order they were made,
    /// a plugin that calls `spawn-npc` more than once for the same table
    /// can still tell its calls apart: track a per-call label (or just a
    /// counter) before each `spawn-npc` call and consume it here in
    /// arrival order, e.g. by round-tripping it through
    /// `plugin-state-set`/`-get` (`docs/specs/Plugin_API.md`'s "Entity
    /// correlation via on-entity-spawn" walks through this).
    /// Only fires back to the plugin whose own `spawn-npc` call caused
    /// the spawn — it does **not** fan out to every loaded plugin the way
    /// most other hooks do (`fire_hook`'s doc comment), and it does
    /// **not** fire for a player entity joining a zone (that's
    /// `on-player-join-zone` below, a different event with different
    /// timing — after roster delivery, not "just spawned").
    on-entity-spawn: func(zone-id: string, entity-id: string, entity-type: string, spawn-table-id: string);

    /// Fired once a player's connection has fully joined `zone-id` —
    /// after roster delivery, so a `send-message` call made from inside
    /// this hook reaches a client that's actually ready to receive it
    /// (docs/PROPOSAL.md's "Player session" hook group,
    /// `on_player_join_zone`). Fires for every zone a player is ever in
    /// — initial connection, a mid-session zone-link crossing (#233), or
    /// both — a plugin checks `zone-id` itself if it only cares about
    /// some.
    on-player-join-zone: func(zone-id: string, entity-id: string);

    /// Fired on a player's clean disconnect from `zone-id`, and also
    /// right before a mid-session zone-link crossing carries them into a
    /// different zone (#233) — the counterpart to `on-player-join-zone`
    /// (`on_player_leave_zone`), same entity id.
    on-player-leave-zone: func(zone-id: string, entity-id: string);

    /// Fired when a player's entity enters a trigger volume in `zone-id`
    /// whose `event` (content::manifest::Trigger) names an interact-style
    /// event — `trigger-id` matches the manifest's `triggers[].id`.
    on-interact: func(zone-id: string, trigger-id: string, actor-entity-id: string);

    /// Fired when the gateway receives a message whose `message_type`
    /// (docs/specs/Networking_Spec.md, "Message framing") matches one of
    /// this plugin's declared `message_types` (`plugin.toml`) —
    /// `zone-id` is the sending connection's current zone, `sender-entity-id`
    /// is the connection's own entity (so the plugin can `send-message` a
    /// reply back to it), `payload` is that envelope's opaque,
    /// message_type-specific bytes, unparsed by the host (#95).
    on-message: func(zone-id: string, message-type: u16, sender-entity-id: string, payload: list<u8>);

    /// Fired when something in the host wants a damage amount computed
    /// against `stat-key` (whatever stat the caller cares about — core
    /// has no privileged notion of HP) before it's applied. The plugin
    /// owns the entire mitigation/armor/resistance formula and is
    /// responsible for actually calling `apply-stat-delta` itself — this
    /// hook alone changes nothing (docs/PROPOSAL.md, "v0 Hooks": "plugin
    /// logic decides both, and explicitly drives the corresponding host
    /// function... to make it happen"). Live (#154): fires when a client
    /// sends an `Attack` action; `zone-id` is where it happened.
    on-damage-calc: func(zone-id: string, attacker-entity-id: string, target-entity-id: string, stat-key: string, base-amount: s64);

    /// Fired once a `report-death` request this plugin made is applied
    /// (#154) — the plugin decided this entity died and reported it;
    /// this is the host's confirmation callback. `zone-id` is the entity's
    /// zone at the time.
    on-death: func(zone-id: string, entity-id: string);

    /// Fired the same way `on-death` is, for `report-respawn` (#154).
    on-respawn: func(zone-id: string, entity-id: string);

    /// Called once per simulation tick, per zone, regardless of NPC
    /// count — the zone-wide counterpart to `on-npc-tick` below (#168),
    /// for time-of-day, periodic world events, or aggregate bookkeeping
    /// a plugin wants to run on a fixed cadence rather than per-entity.
    /// Fires after this tick's queued moves are already applied and
    /// `on-npc-tick` has run for this tick's route-NPCs (`server::
    /// world_actor`'s own dispatch order) — a plugin reacting here sees
    /// positions/state already updated for the tick that just happened,
    /// not the state about to be superseded by it.
    on-tick: func(zone-id: string, dt: f64);

    /// Called once per simulation tick, per zone, for an NPC entity whose
    /// spawn table declared a `route_id` (content::manifest::Route) —
    /// gives the plugin the NPC's current position (`x`, `y`, `z` —
    /// authoritative since #249) and its full route (waypoints, whether
    /// it loops, its declared speed) so the plugin can decide the NPC's
    /// next position and drive it there via `move-entity`. The host
    /// never moves an NPC on its own (docs/PROPOSAL.md, "World Content":
    /// "the core provides the data structure and movement validation;
    /// behavior is a plugin concern"). `route-waypoints` stays 2D
    /// (`content::manifest::Route.waypoints` — #249's scope note: real
    /// 3D zone/route geometry is #242's job, not this interface's).
    on-npc-tick: func(zone-id: string, entity-id: string, x: f64, y: f64, z: f64, route-waypoints: list<tuple<f64, f64>>, route-loop: bool, route-speed: f64, dt: f64);

    /// Fired when a player interacts with an NPC entity specifically
    /// (as opposed to `on-interact`'s generic trigger-volume case) —
    /// `npc-entity-id` is the NPC, `actor-entity-id` is the interacting
    /// player, both in `zone-id`.
    on-npc-interact: func(zone-id: string, npc-entity-id: string, actor-entity-id: string);

    /// Fired for a chat message whose leading `/command` matches one of
    /// this plugin's declared `chat_commands` (`plugin.toml`) — `command`
    /// is the matched name without the leading slash, `args` is
    /// everything after it verbatim (unparsed by the host), `zone-id` is
    /// the sending connection's current zone, and `sender-entity-id` is
    /// the sending connection's own entity (so the plugin can
    /// `send-message` a reply). A matched command is consumed — it is not
    /// also published to `chat` as an ordinary message.
    on-chat-command: func(zone-id: string, command: string, args: string, sender-entity-id: string);

    /// Fired after a `grant-item` call this plugin made is actually
    /// applied (the drain succeeded) — `quantity` is the item type's new
    /// total, not the delta just granted. Live: `world::world_actor`
    /// calls this itself right after applying a queued grant, so unlike
    /// most of this interface's hooks, a plugin can treat this as
    /// confirmation the grant went through. `zone-id` is the entity's
    /// zone at the time.
    on-item-acquire: func(zone-id: string, entity-id: string, item-type: string, new-quantity: s64);

    /// Live (#154): fires when a client sends a `UseItem` action.
    /// `zone-id` is where it happened.
    on-item-use: func(zone-id: string, entity-id: string, item-type: string);

    /// Fired once, right after a `CraftItem` request (#216, implementing
    /// #215's crafting decision) successfully consumes its declared
    /// inputs and grants its declared output — post-craft notification
    /// only, no veto mechanism (#215 deliberately defaults to
    /// post-craft-only; core already enforced the atomic exchange by the
    /// time this fires). No entity/zone context is given — like
    /// `on-character-create`, a craft is account/character-scoped, not
    /// entity-scoped, so `character-id` is what's available; a plugin
    /// wanting to react against the crafting character's stats calls
    /// `apply-stat-delta-for-character`. `recipe-key` is the same key the
    /// `CraftItem` request named, resolved against the dev-declared
    /// `crafting.schema.yaml`. Gated behind the `economy` capability
    /// (`plugin_host::manifest::CAPABILITY_ECONOMY`), the same capability
    /// that already covers `grant-item`/`remove-item`/`modify-currency`.
    on-craft-complete: func(character-id: string, recipe-key: string);
}

world plugin {
    // Rust's std runtime for `wasm32-wasip2` needs the baseline WASI
    // Preview 2 CLI imports (clocks, random, stdio, ...) to link/start at
    // all — sandboxing doesn't come from omitting these, it comes from
    // what the *host* actually grants at instantiation: no preopened
    // directories, no sockets, nothing beyond what `WasiCtxBuilder`
    // explicitly allows (`crate::runtime`). This is WASI Preview 2's own
    // capability-based security model, the same one `wasmtime` itself
    // documents as the intended sandboxing mechanism.
    include wasi:cli/imports@0.2.12;

    import host;
    export hooks;
}
